# Copy this file to ".env" to run the project on your own computer.
# Never upload .env to GitHub.

# Database (Supabase -> Project Settings -> API Keys)
SUPABASE_URL=https://your-project-id.supabase.co
# Collector: use the SECRET key (sb_secret_...), it writes to the database.
# Dashboard only: the PUBLISHABLE key (sb_publishable_...) is enough, it only reads.
SUPABASE_KEY=paste_your_supabase_key_here

# Weather source 1 (openweathermap.org -> My API keys). Free plan.
OWM_API_KEY=paste_your_openweathermap_key_here

# Site location (default: Vancouver, BC)
LAT=49.2827
LON=-123.1207
